/*******************************************************************************
 * ROFI Theme: Hyprland Wallpaper Picker (Final)
 * 5 Sütunlu, Lavanta Vurgulu, TAM ARKA PLAN DOLGUSU.
 *******************************************************************************/

configuration {
    /* `modi:` bilerek yok. wallselect rofi'yi `-dmenu` ile cagiriyor; mod
       bayraktan geliyor ve buradaki deger hicbir zaman okunmuyordu. */
    show-icons:              true;
    drun-display-format:     "{name}";
    font:                    "Ubuntu Nerd Font 11";

    /* Dokunulmadan 10 sn gecerse kapanir -- diger temalarla ayni deger. */
    timeout {
        delay:  10;
        action: "kb-cancel";
    }
}

/* Renk paleti ortak dosyada: colors.rasi */
@import "colors.rasi"

* {
    separatorcolor:      transparent;
    border-color:        transparent;
}

//----- Main Window (Pencere) -----//

window {
    enabled:             true;
    fullscreen:          false;
    width:               100%; 
    transparency:        "real";
    spacing:             0px;
    padding:             0px;
    border:              1px;
    border-radius:       20px;
    border-color:        @tn-accent; 
    background-color:    transparent;
    location:            center;
}

//----- Main Box (Ana Kutu) -----//

mainbox {
    enabled:             true;
    children:            [ "listview" ]; 
    background-color:    @tn-bg;
}

//----- Listview (İkon Listesi) -----//

listview {
    enabled:             true;
    columns:             5; 
    lines:               1; 
    spacing:             40px; 
    padding:             20px 30px;
    cycle:               true;
    scrollbar:           false;
    layout:              vertical; 
    fixed-height:        true;
    fixed-columns:       true;
    background-color:    transparent;
    text-color:          @tn-fg;
}

//----- Elements (Uygulama İkonları) -----//

element {
    enabled:             true;
    orientation:         vertical; 
    spacing:             0px;
    padding:             10px; 
    border-radius:       20px;
    background-color:    transparent;
    text-color:          @tn-fg;
    border:              0px;
}

/* --- Seçili Öğe: TAM ARKA PLAN DOLGUSU --- */
element selected.normal {
    background-color:    @tn-accent;
    text-color:          @tn-bg;
    border:              0px;
    border-radius:       20px;
}

element-icon {
    size:                30%;
    border-radius:       15px;
    background-color:    transparent;
    text-color:          inherit;
}

element-text {
    enabled:             false; 
}
