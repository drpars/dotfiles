/*
 * Rofi Window Switcher Theme: Tokyo Night (Minimal/No Input)
 * Theme Focus: Minimal list for quick window selection.
 */

/* Renk paleti ortak dosyada: colors.rasi */
@import "colors.rasi"

* {
  /* Temel Sıfırlamalar */
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

configuration {
  font: "Ubuntu Nerd Font 11";

  /* Dokunulmadan 10 sn gecerse kendini kapatir. Sayac etkilesimle sifirlanir
     (man rofi, "Timeout"). Ayni deger applications.rasi ve menu.rasi'de de
     yazili -- ucu de ayni davranissin diye. Bu dosya ALT+TAB disinda
     cliphist (ALT+CTRL+V) ve alias (ALT+A) menulerinde de kullaniliyor,
     timeout uclunun hepsine birden uygulanir. */
  timeout {
      delay:  10;
      action: "kb-cancel";
  }
}

/* 1. ANA PENCERE (ROFI'NİN ÇERÇEVESİ) */
window {
  transparency: "real";
  location: center;
  width: 28%; /* Pencereler arası geçiş için daha dar hale getirildi */
  x-offset: 0;
  y-offset: 0;
  
  background-color: @tn-bg;
  border: 1px;
  border-radius: 8px;
  border-color: @tn-accent;
  padding: 10px;
}

/* 2. ANA KUTU */
mainbox {
  border: 0;
  padding: 0;
}

/* 3. ARAMA KUTUSU / GİRİŞ ÇUBUĞU - TAMAMEN KALDIRILDI */
inputbar {
    enabled: false;
}

/* 4. LİSTE GÖRÜNÜMÜ */
listview {
  columns: 1;
  lines: 8; 
  cycle: true;
  dynamic: true;
  scrollbar: false;
  
  background-color: @tn-bg;
}

/* 5. ÖĞELER (PENCERE BAŞLIKLARI) */
element {
  padding: 10px;
  border-radius: 4px;
  orientation: horizontal;
  children: [ element-icon, element-text ];
}

/* Normal Durum */
element normal {
  background-color: @tn-bg;
  text-color: @tn-fg-dim;
}

/* Seçili (Vurgulu) Durum */
element selected {
  background-color: @tn-accent; /* Lavanta Mavi Vurgu */
  text-color: @tn-bg; /* Koyu Metin */
}

element alternate {
  background-color: @tn-bg;
  text-color: @tn-fg-dim;
}

/* 6. İKON VE METİN STİLLERİ */
element-icon {
  size: 20px;
  padding: 0 10px 0 0;
  background-color: transparent;
  text-color: inherit;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  highlight: none; /* Arama çubuğu olmadığı için vurgulama kaldırıldı */
}
