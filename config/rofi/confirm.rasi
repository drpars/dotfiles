/*******************************************************************************
 * ROFI Confirm — Evet/Hayır onay diyalogu
 *
 * powermenu.rasi'yi DEVRALIR (palet, yazi tipi, kenarlik, 10 sn timeout) ve
 * yalnizca tek bir seyi degistirir: SORU METNI GORUNUR OLUR.
 *
 * Neden ayri dosya: powermenu.rasi'de `mainbox { children: [ listview ]; }`
 * yaziyor, yani ne inputbar ne message ciziliyor. Onay diyaloglari o temayi
 * kullandigi icin sorulan sey hic gorunmuyordu -- ekranda yalnizca "Evet /
 * Hayir" duruyordu ve neye cevap verildigi belli degildi (olculdu 2026-08-08,
 * grim ile). Duzeltme cagri yerine -theme-str olarak yazilabilirdi ama iki
 * betikte (scripts/win, scripts/powermenu) ayni dizeyi tekrarlardi; depodaki
 * karar zaten "rofi ayarinin adresi tema dosyasidir".
 *
 * Metin kanali -mesg, -p DEGIL. Olculdu: prompt (inputbar) satir kaydirmaz ve
 * tasan metni ELIPSSIZ, SESSIZCE keser -- 30em'de ~78 karakterden sonrasi yok
 * olur. message widget'i kaydirir; 95 karakterlik soru iki satira sarilarak
 * tam gorundu. Bu yuzden soru uzunlugu icin bir sinir yazilmiyor.
 *
 * -mesg Pango isaretlemesi yorumlar: soru metninde `&` ve `<` kacisli
 * yazilmali (`&amp;`, `&lt;`), yoksa metin cizilmez.
 *******************************************************************************/

@import "powermenu.rasi"

/* 14em -- powermenu.rasi'nin kendi genisligi, yani menuden onaya gecerken kutu
   ziplamiyor.

   Deger 2026-08-17'de 30em'den indirildi. Olcum kanali `hyprctl layers`
   (katmanin gercek xywh'si): 1em = tam 17px, ve yukseklik sarmayi soyluyor --
   139 = mesaj tek satir, 156 = iki satir. powermenu'nun DORT sorusunun dordu
   de 14em'de tek satirda kaliyor; en uzunu ("Yeniden baslatilsin mi?", 23 krk)
   11em'de bile sarmiyor, yani pay genis.

   30em bu dosyaya powermenu icin degil, `scripts/win`in 56 karakterlik pil
   sorusu icin girmisti; o soru 22em'de iki satira sariyor. Tek dosya boyu cok
   farkli iki tuketiciye hizmet ediyordu ve genis olan kazanmisti -- powermenu
   gerekenin ~2,1 kati genis ciziliyordu. Artik aykiri olan kendi dosyasini
   kullaniyor: confirm-wide.rasi. */
window {
    width: 14em;
}

mainbox {
    children: [ message, listview ];
}

/* Iki secenek: Evet / Hayir. Cagri yerinde -theme-str ile tekrar edilmesin. */
listview {
    lines: 2;
}

/* message'in ic widget'i. Alt bosluk soruyu listeden ayirir. */
textbox {
    padding: 4px 6px 10px 6px;
}
