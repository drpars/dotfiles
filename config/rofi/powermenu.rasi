/*******************************************************************************
 * ROFI Power Menu — Tokyonight (Night) · Lavanta vurgulu · kompakt dikey liste
 *******************************************************************************/

/* Renk paleti ortak dosyada: colors.rasi */
@import "colors.rasi"

* {
    border:  0;
    margin:  0;
    padding: 0;
    spacing: 0;

    background-color: @tn-bg;
    text-color:       @tn-fg;
}

configuration {
    font:       "Ubuntu Nerd Font 11";
    show-icons: false;

    /* Dokunulmadan 10 sn gecerse kapanir -- diger temalarla ayni deger.
       Burada ayrica guvenlik islevi var: acik kalmis bir guc menusunde
       sonraki Enter "Kapat"a gidebilir. `confirm()` diyaloglari da bu
       temayi kullandigi icin onlar da kapsanir. */
    timeout {
        delay:  10;
        action: "kb-cancel";
    }
}

window {
    transparency:     "real";
    location:         center;
    width:            14em;
    border:           1px;
    border-radius:    8px;
    border-color:     @tn-accent;
    background-color: @tn-bg;
}

mainbox {
    padding:          10px;
    children:         [ listview ];
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            6;
    spacing:          4px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @tn-fg;
    orientation:      horizontal;
    border-radius:    6px;
    padding:          12px 14px;
}

element selected.normal {
    background-color: @tn-accent;
    text-color:       @tn-bg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
