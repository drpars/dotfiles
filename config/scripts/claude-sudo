#!/usr/bin/env bash
# Toggle passwordless sudo for this user, bounded by the session.
#
# Why it exists: an agent (Claude Code) that runs a privileged command hits an
# interactive password prompt it cannot answer, and the command hangs or fails.
# Typing the password into the agent is not an option either. So the privilege
# is granted for a window, out of band, and revoked when the window closes.
#
# Where the grant lives is the whole design. The rule is a sudoers drop-in in
# /run/sudoers.d, not /etc/sudoers.d. /run is a tmpfs, so the rule cannot
# outlive the boot -- not through a crash, not through a hard reset, not
# through this script failing to clean up. Expiry is a property of the
# filesystem rather than of a cleanup step that might never run.
#
# Logout is the second bound, and that one does need a hook: the systemd *user*
# unit claude-sudo.service, whose ExecStop revokes the grant. Without lingering
# the user manager stops at the last logout, so logging out revokes. If that
# hook ever fails, the tmpfs still caps the exposure at one boot.
#
# That bound is read back rather than assumed. `systemctl start` exiting 0 is a
# different claim from the unit being active, and the earlier behaviour --
# start, warn on stderr, grant anyway -- was measured to fail silently: on one
# machine the grant was live for a whole session with LoadState=not-found,
# because config/systemd was never linked into ~/.config there and nobody read
# the warning. So `on` verifies the unit is active and rolls the grant back
# when it is not; `on --force` grants without the bound and says what is left.
#
# Scope, stated plainly: the rule names the *user*. sudoers matches on who runs
# a command, never on what spawned it, so there is no way to hand this to
# Claude alone -- while the grant is on, anything running as this user reaches
# root without a prompt. That is precisely why this is a toggle and not a line
# in /etc/sudoers.
#
# One-time root setup teaches sudo to read /run/sudoers.d at all, via a nested
# include (see cmd_setup). Everything after that is unprivileged bookkeeping
# plus one sudo call.
#
# The third bound is the agent's own lifetime: the `claude` shell wrapper (see
# config/zsh/functions.zsh) registers a holder while it runs and releases it on
# exit, and the last release closes the window. Holders are counted rather than
# assumed to be one, so a second claude in another terminal does not have root
# pulled out from under it when the first one quits.
#
#   claude-sudo             toggle
#   claude-sudo on|off      explicit
#   claude-sudo on --force  grant even when the logout bound cannot be set up
#   claude-sudo status      report state; exit 0 when on, 1 when off
#   claude-sudo setup       one-time, needs root: install the include hook
#   claude-sudo remove      undo setup
#
# Internal entry points, all prefixed __ because only the unit and the shell
# wrapper call them:
#   __revoke          for the unit's ExecStop: drops the file and nothing else,
#                     so stopping the unit cannot recurse back into it
#   __hold <pid>      register a holder
#   __release <pid>   drop a holder; revoke if it was the last one
#
# Calling this from somewhere that is not the user's own terminal -- ssh, a
# hook, a unit -- goes through the absolute path ~/.config/scripts/claude-sudo,
# never the bare name. The login shell on both machines is bash, and
# `ssh host <cmd>` runs it non-interactively, so no rc file is read at all and
# PATH never gains ~/.config/scripts (that entry is added by
# config/zsh/variables.zsh, which only an interactive zsh sources). Measured:
# `command -v claude-sudo` over ssh fails, the absolute path answers normally.
#
# The two failures must not be collapsed, because they differ by one digit and
# mean opposite things: 127 is "not on PATH, nothing was asked", 1 from
# `status` is "asked, and the grant is off". A remote close that reads 127 as
# "already off" reports success while the window stays open -- that misreading
# happened. systemctl --user does work over ssh: XDG_RUNTIME_DIR and
# DBUS_SESSION_BUS_ADDRESS are both set in that shell (measured), so the unit
# can be started and stopped remotely as well.

set -euo pipefail

RUN_DIR=/run/sudoers.d
RUN_FILE="$RUN_DIR/claude-sudo"
HOOK_FILE=/etc/sudoers.d/99-claude-sudo
UNIT=claude-sudo.service
WHO=$(id -un)
FORCE=0

# One marker file per shell running claude under the wrapper. On the user's
# runtime tmpfs, so it is cleared by the same reboot that clears the grant --
# a leftover marker can never outlive the thing it is counting.
HOLD_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/claude-sudo"

TMP=
cleanup() { [ -n "$TMP" ] && rm -f "$TMP"; return 0; }
trap cleanup EXIT

die() { printf 'claude-sudo: %s\n' "$*" >&2; exit 1; }

# A sudoers file that does not parse breaks sudo for everyone, and the drop-in
# sits in a directory only root can repair. Nothing is ever installed without
# visudo agreeing to it first.
stage() {
    TMP=$(mktemp)
    cat >"$TMP"
    chmod 0440 "$TMP"
    visudo -cqf "$TMP" || die "üretilen sudoers parçası geçersiz, kurulmadı"
}

is_on() { [ -e "$RUN_FILE" ]; }

# Whether the include hook is in place cannot be read directly: /etc/sudoers.d
# is root-only. Ask sudo instead of the filesystem -- if a NOPASSWD rule is
# live, `sudo -n` succeeds without a cached credential.
grant_is_live() { sudo -n true 2>/dev/null; }

# The logout bound, asserted rather than attempted: start only if it is not
# already up, then answer with what the unit actually is. Both halves are
# needed -- `start` on a unit that is not installed fails, and `start` on one
# that is installed can still fail, and neither shows up in a caller that only
# looks at whether the grant file exists.
ensure_unit() {
    if systemctl --user is-active --quiet "$UNIT"; then
        return 0
    fi
    systemctl --user start "$UNIT" 2>/dev/null || true
    systemctl --user is-active --quiet "$UNIT"
}

# Why it is not active, in the words systemd uses. LoadState=not-found is the
# one that means "this machine never got the file", which is a deployment
# question and not a runtime one; ActiveState/Result cover the rest.
unit_diag() {
    systemctl --user show "$UNIT" -p LoadState -p ActiveState -p Result \
        2>/dev/null | tr '\n' ' '
}

cmd_setup() {
    printf 'Bir kerelik kurulum: sudo, /run/sudoers.d dizinini de okuyacak.\n'
    printf 'Parola sorulacak.\n\n'

    stage <<EOF
# Installed by claude-sudo. Nested include so the actual grant can live on
# tmpfs and expire with the boot; this file only points at that directory and
# holds no privilege of its own.
@includedir $RUN_DIR
EOF

    sudo install -d -m 0755 -o root -g root "$RUN_DIR"
    sudo install -m 0440 -o root -g root "$TMP" "$HOOK_FILE"

    # The staged file parsed on its own; re-check the whole tree, because a
    # bad interaction with an existing rule would only show up here. Roll back
    # rather than leave sudo in a state that needs a rescue shell.
    if ! sudo visudo -c >/dev/null; then
        sudo -n rm -f "$HOOK_FILE"
        die "sudoers doğrulaması başarısız, kurulum geri alındı"
    fi

    printf 'Kuruldu: %s\n' "$HOOK_FILE"
    printf 'Artık "claude-sudo" ile açıp kapatabilirsiniz.\n'
}

cmd_remove() {
    revoke
    sudo rm -f "$HOOK_FILE"
    printf 'Kaldırıldı: %s\n' "$HOOK_FILE"
}

cmd_on() {
    if is_on; then
        # The grant is left alone, but a missing bound is still repaired here:
        # this is the path a second claude takes while the window is already
        # open, and it is the only chance to fix a unit that was not up when
        # the window was opened.
        if ! ensure_unit; then
            printf 'claude-sudo: uyarı — %s etkin değil (%s).\n' \
                "$UNIT" "$(unit_diag)" >&2
            printf '  Yetki AÇIK ve oturum kapanışında iptal olmayacak; kalan tek sınır yeniden başlatma.\n' >&2
        fi
        cmd_status
        return 0
    fi

    stage <<EOF
# Written by claude-sudo for $WHO on $(date '+%Y-%m-%d %H:%M:%S').
# On tmpfs by design: this grant cannot survive a reboot. Revoked at logout by
# claude-sudo.service, or right now with \`claude-sudo off\`.
$WHO ALL=(ALL:ALL) NOPASSWD: ALL
EOF

    sudo install -d -m 0755 -o root -g root "$RUN_DIR"
    sudo install -m 0440 -o root -g root "$TMP" "$RUN_FILE"

    # Prove the rule took effect instead of assuming it did. The install above
    # just cached a credential, which would make any check pass; drop it first
    # so the only thing that can answer is the new rule.
    sudo -k
    if ! grant_is_live; then
        sudo rm -f "$RUN_FILE"
        die "kural yazıldı ama etkili olmadı — önce \`claude-sudo setup\` çalıştırın"
    fi

    # The grant is not reported as on until the logout bound is proven. Losing
    # that bound costs more than the comment here used to say: what is left is
    # the reboot, and a desktop that stays up for days is not a bound at all.
    if ! ensure_unit; then
        if [ "$FORCE" = 1 ]; then
            printf 'claude-sudo: UYARI — %s etkin değil (%s).\n' \
                "$UNIT" "$(unit_diag)" >&2
            printf '  Oturum kapanışında iptal YOK; kalan tek sınır yeniden başlatma (/run tmpfs).\n' >&2
            printf '  --force verildiği için yine de açıldı.\n' >&2
        else
            # What the rollback actually did, not what it was asked to do: the
            # one message a reader must be able to trust here is whether root
            # is still handed out.
            local rolled
            if revoke; then
                rolled="yetki geri alındı"
            else
                rolled="yetki geri ALINAMADI, hâlâ açık ($RUN_FILE) — \`claude-sudo off\`"
            fi
            die "$UNIT etkin değil ($(unit_diag)) — çıkış bağı kurulamadı, $rolled.
  LoadState=not-found ise bu makinede dotfiles'ın config/systemd bölümü
  ~/.config'e bağlanmamıştır (archsetup → dotfiles ekranı).
  Bağ olmadan açmak için: claude-sudo on --force"
        fi
    fi

    cmd_status
}

cmd_off() {
    # Stopping the unit runs its ExecStop, which revokes. Do it anyway
    # afterwards: the unit may never have started.
    systemctl --user stop "$UNIT" 2>/dev/null || true
    revoke || die "kural dosyası kaldırılamadı: $RUN_FILE"
    cmd_status || true
}

revoke() {
    is_on || return 0
    # While the grant is on sudo needs no password, so -n is the normal path.
    # It also keeps a stale grant from hanging on a prompt where there is no
    # terminal to answer it -- ExecStop has none.
    if sudo -n rm -f "$RUN_FILE" 2>/dev/null; then
        return 0
    fi
    if [ -t 0 ]; then
        sudo rm -f "$RUN_FILE"
        return 0
    fi
    return 1
}

# A marker is named "<pid>.<starttime>". The pid alone is not an identity:
# pids get reused, and a marker left behind by a shell that died without
# releasing would then look alive forever and hold the window open. The start
# time pins the marker to one specific process.
holder_key() {
    local stat rest
    stat=$(cat "/proc/${1-}/stat" 2>/dev/null) || return 1
    # Count fields from after the closing paren: field 2 is the command name
    # and may itself contain spaces and parentheses. starttime is field 22,
    # which is field 20 of what is left.
    rest=${stat##*') '}
    printf '%s.%s\n' "$1" "$(printf '%s' "$rest" | cut -d' ' -f20)"
}

holder_alive() {
    [ "$(holder_key "${1%%.*}" 2>/dev/null)" = "$1" ]
}

# Is any *other* claude still running? Dead markers are pruned on the way
# through: a shell killed with SIGKILL never runs its release, and a marker
# nobody prunes would keep the window open until logout -- exactly the state
# this wrapper exists to prevent.
holders_remain() {
    local f found=1
    [ -d "$HOLD_DIR" ] || return 1
    for f in "$HOLD_DIR"/*; do
        [ -e "$f" ] || continue
        if holder_alive "${f##*/}"; then
            found=0
        else
            rm -f "$f"
        fi
    done
    return "$found"
}

cmd_hold() {
    local key
    key=$(holder_key "${1-}") || die "tutamak için geçerli bir pid gerekli: '${1-}'"
    mkdir -p "$HOLD_DIR"
    chmod 0700 "$HOLD_DIR"
    : >"$HOLD_DIR/$key"
}

# Reports on stderr, not stdout: this runs as the wrapped command exits, and
# the caller's stdout may be going somewhere that is not a terminal.
cmd_release() {
    local key
    if key=$(holder_key "${1-}" 2>/dev/null); then
        rm -f "$HOLD_DIR/$key"
    fi

    is_on || return 0

    if holders_remain; then
        printf 'claude-sudo: AÇIK kalıyor — başka bir claude oturumu sürüyor.\n' >&2
        return 0
    fi

    systemctl --user stop "$UNIT" 2>/dev/null || true
    revoke || die "kural dosyası kaldırılamadı: $RUN_FILE"
    printf 'claude-sudo: KAPALI — pencere claude ile birlikte kapandı.\n' >&2
}

cmd_status() {
    if is_on; then
        printf 'claude-sudo: AÇIK — %s parolasız sudo kullanabiliyor.\n' "$WHO"
        printf '  Bitiş: oturum kapanışı, yeniden başlatma, ya da "claude-sudo off".\n'
        holders_remain &&
            printf '  Ayrıca: sarmalayıcıyla başlatılmış claude çıkınca da kapanır.\n'
        grant_is_live || printf '  Uyarı: kural dosyası var ama sudo uygulamıyor ("claude-sudo setup" gerekebilir).\n' >&2
        systemctl --user is-active --quiet "$UNIT" ||
            printf '  Uyarı: %s çalışmıyor (%s) — oturum kapanışında iptal olmayacak.\n' \
                "$UNIT" "$(unit_diag)" >&2
        return 0
    fi
    printf 'claude-sudo: KAPALI\n'
    return 1
}

case "${1-}" in
    "")       if is_on; then cmd_off; else cmd_on; fi ;;
    # An unrecognised word here must stop before cmd_on, not be ignored: this
    # subcommand hands out passwordless root, so a typo that silently falls
    # through to the default behaviour grants it. Measured on the third
    # argument, which used to be dropped without a word.
    on)       case "${2-}" in
                  "")      ;;
                  --force) FORCE=1 ;;
                  *)       die "bilinmeyen seçenek: ${2}" ;;
              esac
              [ "$#" -le 2 ] || die "fazladan argüman: ${3}"
              cmd_on ;;
    off)      cmd_off ;;
    status)   cmd_status ;;
    setup)    cmd_setup ;;
    remove)   cmd_remove ;;
    __revoke)  revoke ;;
    __hold)    cmd_hold "${2-}" ;;
    __release) cmd_release "${2-}" ;;
    *)        die "kullanım: claude-sudo [on [--force]|off|status|setup|remove]" ;;
esac
