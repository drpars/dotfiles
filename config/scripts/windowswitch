#!/bin/bash

message="Açık pencere yok!"

window=$(hyprctl clients)
if [ "$window" == "no open windows" ]; then
  notify-send "$message"
  exit 0
else
  # -replace: ikinci ALT+TAB yeni bir ornek acmaz, acik olani degistirir.
  rofi -replace -show window -theme "$HOME/.config/rofi/window.rasi" -matching normal -i
fi
