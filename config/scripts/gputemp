#!/bin/bash
# waybar custom/gputemp -- GPU temperature, whatever GPUs this machine has.
#
# Replaces the gpuasus / gpudesktop pair. Those hardcoded one machine each and
# modules.json could only name one of them, so the laptop ran the desktop's
# script and reported its dGPU only; gpuasus was never called, and would not
# have worked anyway since it looked for the sensor at amdgpu-pci-0600 while
# the real one is amdgpu-pci-0500. Nothing is hardcoded here: each source is
# used if it answers.
#
# Survives the dGPU being handed to a VM. When the card is bound to vfio-pci
# the nvidia driver releases it and /proc/driver/nvidia/gpus empties, so we can
# tell without calling nvidia-smi at all -- which matters at waybar's one
# second interval, where a stalling nvidia-smi would be felt.
#
# With no source at all the text is empty, which is how waybar hides a custom
# module (same convention as peripheral-battery.py).

nvidia_temp() {
  compgen -G "/proc/driver/nvidia/gpus/*" >/dev/null 2>&1 || return 1
  command -v nvidia-smi >/dev/null 2>&1 || return 1
  local t
  t=$(timeout 3 nvidia-smi --query-gpu=temperature.gpu \
        --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  [[ $t =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$t"
}

amd_temp() {
  local hwmon name t
  # Straight from sysfs rather than parsing sensors(1): the hwmon number and the
  # PCI address both differ per board, so we discover the amdgpu one by name.
  # Value is in millidegrees.
  for hwmon in /sys/class/drm/card*/device/hwmon/hwmon*; do
    [ -r "$hwmon/name" ] || continue
    read -r name <"$hwmon/name"
    [ "$name" = amdgpu ] || continue
    [ -r "$hwmon/temp1_input" ] || continue
    read -r t <"$hwmon/temp1_input"
    [[ $t =~ ^[0-9]+$ ]] || continue
    printf '%s' "$((t / 1000))"
    return 0
  done
  return 1
}

nv=$(nvidia_temp) || nv=""
amd=$(amd_temp) || amd=""

short=()
long=()

if [ -n "$nv" ]; then
  short+=("NV ${nv}°C")
  long+=("NVIDIA: ${nv}°C")
fi

if [ -n "$amd" ]; then
  short+=("AMD ${amd}°C")
  long+=("AMD: ${amd}°C")
fi

if [ ${#short[@]} -eq 0 ]; then
  printf '{"text":""}\n'
  exit 0
fi

# One GPU needs no vendor label; a hybrid machine has two temperatures that mean
# different things, so both go on the bar rather than hiding one in the tooltip.
#
# The separator is sized to match the bar. Waybar leaves 20px between the CPU
# module and this one (10px padding each side), but a plain space is only 2px in
# Ubuntu Nerd Font at the bar's 12px, so the two readings sat crammed against a
# wide seam. U+2002 EN SPACE is exactly half an em -- 5px here -- so a bullet
# between two of them lands centred in a 13px gap, close enough to the seam that
# the eye no longer compares them.
if [ ${#short[@]} -eq 1 ]; then
  text="GPU ${short[0]#* }"
else
  text=$(
    IFS=$'\n'
    printf '%s' "${short[*]}"
  )
  # Escapes, not literals: an EN SPACE in the source is indistinguishable
  # from a plain one and the next editor to touch this line would silently
  # "fix" it.
  text=${text//$'\n'/$'\u2002\u2022\u2002'}
fi

tooltip=$(
  IFS=$'\n'
  printf '%s' "${long[*]}"
)
printf '{"text":"%s","tooltip":"%s"}\n' "$text" "${tooltip//$'\n'/\\n}"
