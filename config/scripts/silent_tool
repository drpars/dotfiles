#!/bin/bash

# --- Ayarlar ---
# Sınanabilirlik için değiştirilebilir; varsayılan kurulu tema.
THEME_DIR="${SILENT_THEME_DIR:-/usr/share/sddm/themes/silent}"
TEMP_DIR="/tmp/sddm_silent_v10"
FIRST_BACKUP="${SILENT_BACKUP_DIR:-/usr/share/sddm/themes/silent_original_backup}"

# --- Renkler ---
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Yamanın kapsamı ---
#
# Bu betik iki ayrı mekanizma kullanır, çünkü ölçüm ikisini gerektirdi
# (2026-08-21, ölçümler → pars/dotfiles/arsiv-2026-08.md):
#
# 1) .conf tarafı PAKETE DOKUNMAZ. SDDM tema yapılandırmasını
#    `<ConfigFile>` + `<ConfigFile>.user` olarak okur ve ikincisini birincinin
#    ÜSTÜNE BİRLEŞTİRİR: .user'daki anahtar tabanı ezer, .user'da olmayan taban
#    anahtarı yerinde kalır, .user tabanda hiç olmayan bölüm/anahtar ekleyebilir.
#    Bu yüzden çeviriler configs/<ad>.conf.user dosyalarına yazılır — bunlar
#    pakete ait olmadığı için yükseltmede geri alınmaz ve `pacman -Qkk`'de
#    uyuşmazlık üretmez.
#
# 2) .qml tarafı yamalanmak ZORUNDA, ama eskisinden çok daha dar.
#    LoginScreen.qml'deki metin çevirileri ÖLÜ KODDU ve kaldırıldı: o dizeler
#    `textConstants.X ? textConstants.X : "English"` biçiminde yazılmış ve
#    SDDM kendi çevirisini getiriyor (/usr/share/sddm/translations-qt6/tr.qm),
#    yani literal dala hiç düşülmüyor. Ölçüldü: LANG=tr_TR ile login=[Giriş],
#    password=[Parola], userName=[Kullanıcı adı], loginFailed=[Giriş başarısız],
#    capslockWarning=[Uyarı, Caps Lock AÇIK! ]; LANG=C ile hepsi İngilizce.
#    Yani ekrandaki metni yerel belirliyor, bu betik değil.
#    `textConstants.promptUser` tr.qm'de ÇEVRİLMEMİŞ ama DOLU
#    ("Enter your username"). Bu METİN ÇEVRİLMİYOR ve çevrilmesi de GEREKMİYOR:
#    onu basan dal, kullanıcı listesi boş değilken ULAŞILMAZ (ölçüldü
#    2026-08-21). login() `foundUsers ? userName : userInput.text` yazıyor;
#    userName, UserSelector'ın onCurrentIndexChanged'i sayesinde LoginScreen'in
#    Component.onCompleted'ından ÖNCE doluyor, ve üç login() çağrısının üçü de
#    aynı ifadeyi kullanıyor. Boş kullanıcı modelinde dal açılır — ama o ekranda
#    zaten textConstants YEDEĞİ HİÇ OLMAYAN bir cümle var (LoginScreen.qml
#    noUsersMessage: "SDDM could not find any user..."), yani promptUser'ı tek
#    başına çevirmek o ekranı Türkçe yapmaz.
#
# Geriye kalan gerçekten etkili .qml işi: LoginScreen'in klavye bloğu ve
# MenuArea/UserSelector'ın tooltip'leri (textConstants yedeği YOK, ölçüldü).
#
# Temada textConstants yedeği HİÇ OLMAYAN iki İngilizce cümle var; ikisi de
# ARIZA dalında ve bu makinede ULAŞILMAZ, o yüzden bilerek çevrilmiyor:
#   - LoginScreen.qml  noUsersMessage   → koşul: userModel boş (burada 1 kullanıcı)
#   - LayoutSelector.qml noLayoutMessage → koşul: keyboard.layouts boş
# İkincisinin koşulu DisplayServer'a bağlı (ölçüldü 2026-08-21): QPA=xcb ile
# 2 düzen geliyor (Turkish, English (US)) ve mesaj gizli; QPA=offscreen ile 0
# geliyor ve mesaj görünür olurdu. /etc/sddm.conf DisplayServer'ı ayarlamıyor,
# paket varsayılanı x11. DisplayServer=wayland'a geçilirse bu cümle EKRANA
# ÇIKAR — o zaman çevirisi silent_tool'un işi olur.

# Etkili tooltip çevirileri olan dosyalar; durum denetiminin kapsamı da budur.
# Tema kökünü taramak yanlış cevap verir: docs/options.json ve
# components/Config.qml aynı İngilizce dizeleri "varsayılan değer" olarak
# belgeliyor, yani kök taraması yama yerindeyken bile eşleşme bulur
# (ölçüldü 2026-08-21: 3 sahte eşleşme, ikisi bu iki dosyada).
QML_FILES=(MenuArea UserSelector)
EN_QML='"(Change keyboard layout|Change session|Power options|Toggle virtual keyboard|Close user selection|Select user)"'
EN_CONF='en_US|Logging in|Press any key'

# --- Fonksiyonlar ---

die() {
  echo -e "${RED}HATA: $1${NC}" >&2
  exit 1
}

show_help() {
  echo -e "${BLUE}====================================================${NC}"
  echo -e "${BLUE}   SilentSDDM Yönetim ve Onarım Paneli v10.0        ${NC}"
  echo -e "${BLUE}====================================================${NC}"
  echo -e "${YELLOW}Kullanım:${NC} $0 [SEÇENEK]"
  echo ""
  echo -e "${GREEN}  -t, --translate${NC}   Türkçeleştirme ve klavye yamasını PRISTINE'den kurar."
  echo -e "${GREEN}  -r, --restore${NC}     İlk orijinal yedeğe geri döner (.user dosyaları da gider)."
  echo -e "${GREEN}  -s, --status${NC}      Yamanın yerinde olup olmadığını söyler."
  echo -e "                    Çıkış kodu: ${GREEN}0${NC}=yerinde  ${RED}1${NC}=geri alınmış  ${RED}2${NC}=bozuk"
  echo -e "${GREEN}  --test${NC}            Temayı test modunda açar (sudo gerekmez)."
  echo ""
  echo -e "${YELLOW}Not:${NC} Çeviriler ${BLUE}configs/*.conf.user${NC} dosyalarında; bunlar pakete ait"
  echo -e "     ${GREEN}değil${NC}, yükseltmede geri alınmaz. Yükseltmede geri alınan tek şey üç"
  echo -e "     ${BLUE}.qml${NC} dosyası. Yükseltme sonrası ${GREEN}-s${NC} sorar, ${GREEN}-t${NC} yeniden kurar."
  echo -e "${YELLOW}Not:${NC} ${GREEN}-t${NC} her koşuda yedekten yeniden kurar, yani tekrar çalıştırmak"
  echo -e "     güvenli ve bozuk yamayı da onarır."
  echo -e "${BLUE}====================================================${NC}"
}

# Bir .conf dosyasından, yalnız çevrilecek anahtarları taşıyan .user içeriğini
# üretir. Bölüm başlığı ancak altında yazılacak bir anahtar varsa basılır.
gen_user_conf() {
  awk '
    BEGIN { last = "" }
    /^[[:space:]]*\[/ { sec = $0; next }
    /en_US|Logging in|Press any key/ {
      line = $0
      gsub(/en_US/, "tr_TR", line)
      gsub(/Logging in/, "Giriş yapılıyor...", line)
      gsub(/Press any key/, "Bir tuşa basın", line)
      if (sec != last) {
        if (last != "") print ""
        print sec
        last = sec
      }
      print line
    }
  ' "$1"
}

# Yamanın yerinde olup olmadığını yazdırır ve çıkış koduyla söyler:
#   0 = yerinde, 1 = geri alınmış / eksik, 2 = bozuk
check_status() {
  local rc=0 n f miss="" conf base uncovered=0 total=0 dirty=0

  [ -d "$THEME_DIR" ] || die "Tema dizini bulunamadı: $THEME_DIR"

  echo -e "${YELLOW}--- Yama Durumu ---${NC}"

  # 1) Klavye yaması. Sayı da ölçülür, çünkü enjeksiyon çapası
  #    (`id: loginScreen` / `id: root`) eşleşen HER satırın ardına ekliyor:
  #    ikinci bir çapa çift blok demektir, o da QML'i kırar ve greeter açılmaz.
  n=$(grep -c 'VirtualKeyboardSettings.locale' "$THEME_DIR/components/LoginScreen.qml" 2>/dev/null)
  n=${n:-0}
  if [ "$n" -eq 1 ]; then
    echo -e "${GREEN}  ✔${NC} Klavye yaması: yerinde"
  elif [ "$n" -eq 0 ]; then
    echo -e "${RED}  ✘${NC} Klavye yaması: yok"
    rc=1
  else
    echo -e "${RED}  ‼${NC} Klavye yaması: $n kez enjekte edilmiş — QML bozuk"
    rc=2
  fi

  # 2) Tooltip'ler: yalnız etkili olan iki bileşen taranır.
  for f in "${QML_FILES[@]}"; do
    n=$(grep -cE "$EN_QML" "$THEME_DIR/components/$f.qml" 2>/dev/null)
    n=${n:-0}
    [ "$n" -gt 0 ] && miss="$miss $f.qml($n)"
  done
  if [ -z "$miss" ]; then
    echo -e "${GREEN}  ✔${NC} Tooltip metinleri: Türkçe"
  else
    echo -e "${RED}  ✘${NC} Tooltip metinleri: İngilizce kalan →$miss"
    [ "$rc" -eq 0 ] && rc=1
  fi

  # 3) Yapılandırma: taban .conf İngilizce kalır (normal), karşılığı .user'da olur.
  for conf in "$THEME_DIR"/configs/*.conf; do
    [ -f "$conf" ] || continue
    total=$((total + 1))
    grep -qE "$EN_CONF" "$conf" 2>/dev/null || continue # tabanda çevrilecek yok
    if [ -f "$conf.user" ] && ! grep -qE "$EN_CONF" "$conf.user" 2>/dev/null &&
      [ -s "$conf.user" ]; then
      continue
    fi
    uncovered=$((uncovered + 1))
  done
  if [ "$uncovered" -eq 0 ]; then
    echo -e "${GREEN}  ✔${NC} Yapılandırma (.conf.user): $total config karşılanmış"
  else
    echo -e "${RED}  ✘${NC} Yapılandırma (.conf.user): $uncovered/$total config karşılanmamış"
    [ "$rc" -eq 0 ] && rc=1
  fi

  # 4) Bilgi: pakete ait .conf dosyalarına dokunulmuş mu. Yamanın amacı
  #    dokunmamak; burada çıkan sayı eski biçim yamanın kalıntısıdır.
  if [ -d "$FIRST_BACKUP/configs" ]; then
    for conf in "$THEME_DIR"/configs/*.conf; do
      base="$FIRST_BACKUP/configs/$(basename "$conf")"
      [ -f "$base" ] || continue
      cmp -s "$conf" "$base" || dirty=$((dirty + 1))
    done
    if [ "$dirty" -eq 0 ]; then
      echo -e "${GREEN}  ✔${NC} Paket .conf dosyaları: dokunulmamış"
    else
      echo -e "${YELLOW}  !${NC} Paket .conf dosyaları: $dirty dosya değiştirilmiş (eski biçim yama) — $0 -t temizler"
    fi
  fi

  echo ""
  case "$rc" in
  0) echo -e "${GREEN}SONUÇ: Yama yerinde.${NC}" ;;
  1) echo -e "${RED}SONUÇ: Yama geri alınmış.${NC} Uygulamak için: $0 -t" ;;
  2) echo -e "${RED}SONUÇ: Yama bozuk.${NC} Onarmak için: $0 -t" ;;
  esac
  return $rc
}

restore_original() {
  [ -d "$FIRST_BACKUP" ] || die "Orijinal yedek bulunamadı: $FIRST_BACKUP"
  echo -e "${YELLOW}Orijinal dosyalar geri yükleniyor...${NC}"
  sudo rm -rf "$THEME_DIR" || die "Tema dizini silinemedi; hiçbir şey değişmedi."
  # Buradan sonrası pencere: dizin silindi, yerine konmadı.
  sudo cp -r "$FIRST_BACKUP" "$THEME_DIR" ||
    die "Yedek geri kopyalanamadı ve TEMA DİZİNİ ŞU AN YOK. Elle: sudo cp -r $FIRST_BACKUP $THEME_DIR"
  echo -e "${GREEN}✔ Tema orijinal haline döndürüldü.${NC}"
}

run_test() {
  [ -f "$THEME_DIR/test.sh" ] || die "$THEME_DIR/test.sh bulunamadı!"
  echo -e "${BLUE}--- Tema Test Ekranı Açılıyor ---${NC}"
  (cd "$THEME_DIR" && ./test.sh)
}

translate_theme() {
  echo -e "${BLUE}--- İşlem Başlatılıyor ---${NC}"
  [ -d "$THEME_DIR" ] || die "Tema dizini bulunamadı: $THEME_DIR"

  # 0. Yedek. Yeniden kurma buradan beslendiği için yedeğin PAKETİN KENDİSİ
  #    olması şart: kirli bir yedek, her koşuda kirliliği geri getirir.
  if [ ! -d "$FIRST_BACKUP" ]; then
    n=$(LC_ALL=C pacman -Qkk sddm-silent-theme 2>&1 | grep -c "SHA256")
    [ "$n" -eq 0 ] ||
      die "Yedek yok ve kurulu tema pakete uymuyor ($n dosya). Önce: sudo pacman -S sddm-silent-theme"
    sudo cp -r "$THEME_DIR" "$FIRST_BACKUP" ||
      die "Orijinal yedek alınamadı; tema DEĞİŞMEDİ."
    echo -e "${BLUE}[YEDEK]: Orijinal yapı $FIRST_BACKUP adresine saklandı.${NC}"
  fi

  # 1. Hazırlık: TEMP, yamalı kurulumun değil YEDEĞİN kopyasıdır. Yama böylece
  #    "ne varsa üstüne yaz" değil "pristine'den yeniden kur" olur; tekrar
  #    çalıştırmak idempotent ve bozuk yama (çift blok) kendiliğinden onarılır.
  rm -rf "$TEMP_DIR" || die "Geçici dizin temizlenemedi: $TEMP_DIR"
  cp -r "$FIRST_BACKUP" "$TEMP_DIR" || die "Yedek geçici dizine kopyalanamadı."
  # Yedek pakete ait olmayanları (arka planlar, avatar) taşımaz; onları kurulu
  # temadan tamamla, ama paket dosyalarını EZME.
  cp -rn "$THEME_DIR/." "$TEMP_DIR/" 2>/dev/null

  # 2. LoginScreen.qml: Klavye Yaması Enjeksiyonu
  echo -e "${YELLOW}-> Klavye ayarları işleniyor...${NC}"
  if ! grep -q "VirtualKeyboardSettings.locale" "$TEMP_DIR/components/LoginScreen.qml"; then
    # Ana ID satırından sonraya klavye bloğunu ekler
    sed -i '/id: loginScreen\|id: root/a \
    \
    // Klavye gösterildiğinde Türkçe yap\
    onShowKeyboardChanged: {\
        if (showKeyboard) {\
            VirtualKeyboardSettings.locale = Languages.getKBCodeFor("tr");\
        }\
    }' "$TEMP_DIR/components/LoginScreen.qml" || die "Klavye bloğu enjekte edilemedi."
    echo -e "${BLUE}[EKLEME]: Sanal klavye Türkçe yerelleştirmesi eklendi.${NC}"
  fi

  # 3. MenuArea.qml: Tooltip Çevirileri (textConstants yedeği yok → etkili)
  echo -e "${YELLOW}-> Tooltip metinleri işleniyor...${NC}"
  sed -i -e 's/"Change keyboard layout"/"Klavye düzenini değiştir"/g' \
    -e 's/"Change session"/"Oturumu değiştir"/g' \
    -e 's/"Power options"/"Güç seçenekleri"/g' \
    -e 's/"Toggle virtual keyboard"/"Sanal klavyeyi aç\/kapat"/g' \
    "$TEMP_DIR/components/MenuArea.qml" || die "MenuArea.qml düzenlenemedi."

  # 4. UserSelector.qml: Kullanıcı Seçimi Çevirileri
  #    `Select user ${model.name}` şablon literali 1.5.0'da YOK; o kural
  #    hiç eşleşmediği için kaldırıldı (ölçüldü 2026-08-21).
  sed -i -e 's/"Close user selection"/"Kullanıcı seçimini kapat"/g' \
    -e 's/"Select user"/"Kullanıcı seç"/g' \
    "$TEMP_DIR/components/UserSelector.qml" || die "UserSelector.qml düzenlenemedi."

  # 5. .conf tarafı: paket dosyasına DOKUNULMAZ, yanına .user yazılır.
  echo -e "${YELLOW}-> Yapılandırma override'ları üretiliyor (.conf.user)...${NC}"
  rm -f "$TEMP_DIR/configs"/*.conf.user
  local conf out n_user=0
  for conf in "$TEMP_DIR/configs"/*.conf; do
    [ -f "$conf" ] || continue
    grep -qE "$EN_CONF" "$conf" || continue
    out="$conf.user"
    {
      echo "; silent_tool tarafından üretildi — elle düzenlenmez."
      echo "; SDDM bunu <ConfigFile>.user olarak okur ve tabanın ÜSTÜNE birleştirir:"
      echo "; buradaki anahtar tabanı ezer, buraya yazılmayan taban anahtarı kalır."
      echo "; Pakete ait değil — yükseltmede geri alınmaz."
      echo ""
      gen_user_conf "$conf"
    } >"$out" || die "$(basename "$out") üretilemedi."
    n_user=$((n_user + 1))
  done
  echo -e "${BLUE}[ÜRETİLDİ]: $n_user adet .conf.user${NC}"

  # 6. Uygulama ve Yetki İstemi
  echo -e "${YELLOW}Değişiklikler sisteme yazılıyor (Şifre gerekebilir)...${NC}"

  # Eski biçim yamanın kalıntısı .conf'lar da böyle temizlenir: TEMP paket
  # sürümünü taşıyor ve üzerine kopyalanıyor.
  if ! sudo cp -rf "$TEMP_DIR/." "$THEME_DIR/"; then
    rm -rf "$TEMP_DIR"
    die "Değişiklikler yazılamadı (sudo reddedildi ya da zaman aşımına uğradı). Tema DEĞİŞMEDİ."
  fi

  rm -rf "$TEMP_DIR"

  # 7. Doğrulama: sonuç varsayılmaz, sorulur.
  echo ""
  check_status
  local st=$?
  [ "$st" -eq 0 ] || {
    echo -e "${RED}Yazma bitti ama doğrulama geçmedi.${NC}" >&2
    exit "$st"
  }

  echo -e "${GREEN}✔ İŞLEM TAMAMLANDI!${NC}"
  echo -e "${YELLOW}Test etmek için:${NC} $0 --test"
}

# --- Başlatıcı ---
case "$1" in
-t | --translate) translate_theme ;;
-r | --restore) restore_original ;;
-s | --status | --scan) check_status ;;
--test) run_test ;;
-h | --help | *) show_help ;;
esac
