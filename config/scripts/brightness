#!/bin/bash
# Backlight control.
#   brightness up|down|get [screen|kbd]      target defaults to screen
#
# Replaces the brightness / brightnessasuskbd pair. Both drove brightnessctl
# through the same four functions and differed only in device, step size and
# the label on the notification, so they are one script with an argument.
#
# Kept in bash on purpose: this runs on a key press, with key repeat, and a
# python interpreter start would be felt on every step.
#
# THE ONE PLACE A BRIGHTNESS STEP IS DECIDED. Every consumer lands here: the
# Fn keys (keybindings.lua), and waybar's backlight module, whose on-click /
# on-scroll entries point at this script -- waybar-backlight(5) says those
# "replace the default behaviour of brightness control", so the module writes
# nothing on its own. Anything added later goes through here too, because the
# ceiling below cannot be expressed anywhere else.

KBD_LED="asus::kbd_backlight"

action=${1:-get}
target=${2:-screen}

case "$target" in
screen)
  # -c backlight PINS THE CLASS, and that is the whole guard. With no device
  # and no class, brightnessctl does not stop when the backlight class is
  # empty -- it falls through to the NEXT class and picks a led. Measured on
  # panthera (2026-08-31, brightnessctl 0.5) while ddcci was uninstalled:
  # `brightnessctl -m` returned "phy0-led,leds,1,100%,1", the Wi-Fi LED, and
  # since it reports max=1 the max>0 guard below sailed straight past it. The
  # Fn keys were driving that LED: ceiling=1, delta=1, so one press of down
  # switched it off and the panel announced "Ekran Parlaklığı: 0%".
  # With the class pinned, the empty case is unambiguous (measured, same box):
  # stdout empty, rc=1, message on stderr -- so max stays unset and the guard
  # below holds. hypridle calls brightnessctl directly rather than through this
  # script, so it needed the same flag on its own three call sites (0d3ed59).
  dev=(-c backlight)
  step=10
  label="Ekran Parlaklığı"
  # THE TOP OF THE ADVERTISED RANGE IS NOT REACHABLE. On linux-zen 7.1.8 the
  # amdgpu PWM mapping overflows 16 bits near the top: raw 64500 still gives
  # PWM 0xffff, raw 64550 gives 0x00e8 -- it wraps, and the panel goes black.
  # Measured through /sys/kernel/debug/dri/*/eDP-1/amdgpu_target_backlight_pwm:
  #
  #   raw 64000 -> 0xfe2c    raw 64300..64500 -> 0xffff   (saturated)
  #   raw 64550 -> 0x00e8    raw 65534/65535  -> 0x048e   (wrapped, dark)
  #
  # Two consequences. The PWM SATURATES at raw 64300 = 98.1% of max, so every
  # raw value above that buys no brightness at all -- it only walks toward the
  # wrap. And "max - 1" is no fix: 65534 is deep inside the wrapped region,
  # which is why the first attempt at this still went dark.
  #
  # So the headroom is a FRACTION of the advertised range, not a raw offset,
  # and it is taken at every step because max moves with the kernel (zen 65535,
  # g14 62451) and even the device name moves with the boot (amdgpu_bl2 once,
  # amdgpu_bl1 the next). 3% lands on 63569 here: PWM 0xfd43, i.e. 98.9% of
  # what the panel can emit -- no eye can see the difference -- while sitting
  # 981 raw units below the wrap. 2% would be 0.7 points brighter for a third
  # of the margin, which is the wrong side of that trade.
  headroom_pct=3
  ;;
kbd)
  # Only ASUS laptops have this LED. Bail quietly elsewhere so the script is
  # safe to run by hand on any machine; the keybinding is gated too.
  [ -e "/sys/class/leds/$KBD_LED" ] || exit 0
  dev=(-d "$KBD_LED")
  step=33
  label="Klavye Parlaklığı"
  # No headroom: this LED has four levels (0-3) and the top one is a working
  # value. The defect above belongs to the panel, not to backlights in general.
  headroom_pct=0
  ;;
*)
  echo "usage: brightness up|down|get [screen|kbd]" >&2
  exit 1
  ;;
esac

# device,class,current,percent,max -- one call, the two raw numbers we need.
IFS=, read -r _ _ cur _ max < <(brightnessctl "${dev[@]}" -m 2>/dev/null)

# No backlight at all (the desktop has none while ddcci is out): do nothing,
# quietly, like the kbd guard above. This tests the parsed maximum rather than
# a sysfs path so it also covers a device that exists but reads nothing -- but
# it only works because the CLASS is pinned above. Unpinned it was the bug:
# every class has some device with max>0, so "nothing to drive" and "wrong
# thing to drive" produced identical output here.
[ -n "$max" ] && [ "$max" -gt 0 ] || exit 0

# The ceiling IS this script's 100%. Percentages are taken against it, not
# against max_brightness, so pressing up to the top still says 100% and ten
# steps still cover the whole usable range. brightnessctl and waybar's tooltip
# both divide by max instead, so they read ~97% at the top -- that is them
# describing an unreachable range, not a disagreement about the value.
ceiling=$((max - max * headroom_pct / 100))

percent() {
  local p=$(((cur * 100 + ceiling / 2) / ceiling))
  ((p > 100)) && p=100
  echo "$p"
}

notify() {
  notify-send -e \
    -h string:x-canonical-private-synchronous:info \
    -h "int:value:$1" -u low "$label: $1%"
}

case "$action" in
up | down)
  # The step is computed here instead of being handed to brightnessctl as
  # "10%+" because brightnessctl clamps to max -- the far side of the wrap --
  # and has no way to express a lower ceiling. The shape of the formula is its
  # own, measured: truncated, but never zero (on the 3 step LED a percentage
  # step truncates to nothing, and the LED would never move).
  delta=$((ceiling * step / 100))
  ((delta < 1)) && delta=1

  [ "$action" = up ] && cur=$((cur + delta)) || cur=$((cur - delta))
  # Clamping down is also the way OUT of a dark screen: if something left the
  # value inside the wrapped region, one press of up lands on the ceiling.
  ((cur > ceiling)) && cur=$ceiling
  ((cur < 0)) && cur=0

  brightnessctl "${dev[@]}" -q set "$cur" && notify "$(percent)"
  ;;
get)
  echo "$(percent)%"
  ;;
*)
  echo "usage: brightness up|down|get [screen|kbd]" >&2
  exit 1
  ;;
esac
