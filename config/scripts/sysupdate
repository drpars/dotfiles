#!/bin/bash
# Bar tıklamasıyla açılan güncelleme penceresi.
#
#   sysupdate repo   -- sudo pacman -Syu   (custom/pacman sol tık)
#   sysupdate aur    -- yay -Sua           (custom/pacman sağ tık)
#
# TEK ÖRNEK GARANTİSİ BU BETİKTE DEĞİL, ÇAĞIRANDA. İkisi de `tuipop Update`
# ile çağrılıyor — AYNI ad, dolayısıyla AYNI kilit (`tuipop-Update.lock`).
# Biri koşarken diğerine tıklamak var olan pencereyi öne getirir. Ayrı adlar
# yazılsaydı iki ayrı kilit olurdu ve ikisi sessizce aynı anda koşardı; bu
# satır o hatayı önlemek için burada.
#
# NEDEN KİLİT GEREKİYOR: `yay -Sua` AUR paketlerini DERLİYOR. Yarım
# güncellenmiş kütüphanelere karşı derlemek gerçek bir tehlike ve pacman'in
# kendi db kilidi bunu KORUMAZ — o yalnız kurulum adımını kilitler, derleme
# adımını değil. Yani koruma bu seviyede olmak zorunda.
#
# `yay -Syu` DEĞİL `-Sua`: yay pacman'in sarmalayıcısı, `-Syu` repo
# paketlerini de yükseltir ve sağ tık sol tıkı kapsardı. `-a/--aur` =
# "Assume targets are from the AUR" (yay --help).
#
# PENCERE KOMUT BİTİNCE KAPANMAZ. Devralınan tuipop çağrılarının beşi de
# sonsuz TUI (btop, nvtop, bluetui, impala) — bitiş diye bir şeyleri yok.
# Güncelleme ise biter, ve kitty o anda kapanırsa sonucu, hatayı, `.pacnew`
# uyarısını ya da keyring sorununu okuyamazsın. Sondaki bekleme süsleme değil.
#
# SUDO BURADA NORMAL SORULUR: kitty gerçek bir terminal, denetim tty'si var.
# Claude Code kabuğundaki askpass/`!` kanalının bu betikle ilgisi yok.

set -uo pipefail

MODULE="$HOME/.config/scripts/waybar-updates"
SIGNAL=12   # waybar custom/pacman "signal": 12

case "${1:-}" in
  repo)
    baslik="Resmi depo güncellemesi  --  pacman -Syu"
    komut=(sudo pacman -Syu)
    # Sol tık AUR'a dokunmuyor (kullanıcı kararı 2026-08-13). Kalan AUR
    # güncellemesi ikonu yanık bırakır ve bu YALAN DEĞİL; aşağıdaki rapor
    # bunu görünür kılıyor ki "güncelledim, hâlâ yanıyor" şaşırtmasın.
    ipucu="AUR kaldıysa bar ikonu yanık kalır — sağ tık onu alır."
    ;;
  aur)
    baslik="AUR güncellemesi  --  yay -Sua"
    komut=(yay -Sua)
    ipucu=""
    ;;
  *)
    printf 'kullanım: sysupdate repo|aur\n' >&2
    exit 2
    ;;
esac

if ! command -v "${komut[0]}" >/dev/null 2>&1; then
  printf '\n  %s bulunamadı.\n\n' "${komut[0]}"
  [ -t 0 ] && { printf '  Kapatmak için bir tuşa bas... '; read -rsn1 _; }
  exit 127
fi

printf '\n  \033[1m%s\033[0m\n\n' "$baslik"

# ÇIKTI YAKALANIR AMA TEK AKIŞTA KALIR. Yakalamanın gerekçesi duruyor ve
# ölçülmüş bir kullanımdan geliyor: ilk gerçek sol tıkta pacman indirme
# aşamasında düştü, 111 paketlik çıktı hata satırını yukarı kaydırmıştı ve
# rapor "yukarıdaki çıktıyı oku" diyerek kaymış bir yeri işaret ediyordu.
# Hata metni `pacman.log`'da YOKTUR (log işlemleri tutar), yakalanmazsa geri
# getirilemez.
#
# ÖNCEKİ BİÇİM (stdout tty'de, yalnız stderr `tee` ile kopyalanıyordu) BU
# GEREKÇEYİ KARŞILIYORDU AMA SIRAYI BOZDU. İki ayrı yol terminalde yeniden
# birleşiyor ve aralarındaki sıra zamanlamaya kalıyor. Bedeli tam da onay
# adımına düştü: pacman ONAY SORUSUNU stderr'e yazar (yönlendirme altında da
# görünsün diye), PAKET TABLOSUNU stdout'a — yani "neyi onaylıyorum" ile
# "onaylıyor musun" ayrı yollara ayrılmıştı. Ölçüldü (2026-08-14): bölünmüş
# yapıda `pacman -Q`'nun `hata:` satırları 3/3 koşuda birer satır kaydı, tek
# tty'de kusursuz sıralıydı; gerçek bir güncellemede soru tablonun 12 satır
# ÜSTÜNDE çıktı. Ekranın dibinde soru kalmadığı için "sorulmadı" sanıldı ve
# körlemesine Enter'landı -- Enter = EVET (varsayılan `[E/h]`), yani liste
# hiç görülmeden onaylandı. `--noconfirm` yokken fiilen onaysız güncelleme.
#
# `script` çocuğa GERÇEK bir pty verir: pacman yine tty görür (ilerleme
# çubukları ve sütun genişliği bozulmaz), ama stdout ile stderr aynı akışta
# kalır — sıra artık yapısal olarak korunur, yarış yok. Log, ekranın kopyası.
#
# PAROLA LOGA DÜŞMEZ: `script` ÇIKTIYI kaydeder, echo'suz girdiyi değil.
# Ölçüldü: echo'lu `read` girdisi logda çıktı, `read -s` girdisi çıkmadı;
# sudo parolayı echo'suz okur.
hatalog=$(mktemp --suffix=-sysupdate) || hatalog=""
temizle=1   # başarılıysa log silinir; düşen koşuda 0'a iner ve durur

if [[ -n $hatalog ]] && command -v script >/dev/null 2>&1; then
  # `-e`: çocuğun çıkış kodunu döndür -- yoksa `script` hep 0 döner ve düşen
  # koşu başarılı sayılırdı. `-c` tek bir DİZİ ister, dizi değil; `@Q` her
  # kelimeyi kabuk-güvenli tırnaklar.
  script -q -e -c "${komut[*]@Q}" "$hatalog"
  rc=$?
else
  "${komut[@]}"
  rc=$?
fi

# --- bitiş raporu ----------------------------------------------------------
printf '\n\033[1m----------------------------------------\033[0m\n'
if ((rc == 0)); then
  printf '  Bitti.\n'
else
  printf '  \033[1;31mÇıkış kodu %d\033[0m\n' "$rc"
  # Hata satırlarını rapora geri getir. Kuyruk sınırlı: amaç çıktıyı ikinci
  # kez basmak değil, en son ne söylendiğini göz hizasına almak.
  if [[ -n $hatalog && -s $hatalog ]]; then
    printf '\n  \033[1mSon hata satırları:\033[0m\n'
    # Log artık ekranın TAM kopyası, yani içinde renk dizileri, ilerleme
    # çubuklarının `\r` ile üst üste yazdığı ara kareler ve `script`'in kendi
    # başlık/bitiş satırları var. Önce temizlenir; sonra HATA satırları aranır.
    # Eskiden ham `tail` vardı ve kuyruğa sorular, `::` bilgi satırları da
    # giriyordu -- aranan şey oysa hatanın metni.
    temiz=$(sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\x1b[()][A-Z0-9]//g' "$hatalog" \
              | tr '\r' '\n' \
              | grep -avE '^Script (started|done) on ' \
              | grep -a .)
    # Türkçe locale'de pacman `hata:`/`uyarı:` yazar, İngilizce'de
    # `error:`/`warning:`; yay ikisini de kullanır. Hiç eşleşme yoksa eski
    # davranışa düşülür -- boş rapordan kırpılmış çıktı iyidir.
    hatalar=$(printf '%s\n' "$temiz" | grep -aE '^(hata|error|uyarı|warning):' | tail -n 12)
    [[ -z $hatalar ]] && hatalar=$(printf '%s\n' "$temiz" | tail -n 12)
    printf '%s\n' "$hatalar" | sed 's/^/  | /'
    printf '\n  Tamamı: %s\n' "$hatalog"
    temizle=0   # düşen koşuda log DURUR, kullanıcı okuyabilsin
  else
    printf '  Ayrıntı yakalanamadı — pencereyi yukarı kaydır.\n'
  fi
fi

# Güncel durumu modülün KENDİ betiğinden sor: tek bir doğruluk kaynağı olsun,
# sayım mantığı burada ikinci kez yazılmasın. Çevrimiçi senkron dahil ~3 sn.
if [[ -x $MODULE ]]; then
  durum=$("$MODULE" 2>/dev/null | jq -r '.tooltip // empty' 2>/dev/null)
  [[ -n $durum ]] && printf '  Durum: %s\n' "$durum"
fi
[[ -n $ipucu ]] && printf '  %s\n' "$ipucu"

# Barı tazele. `-x`: ada göre eşleşir, komut satırına DEĞİL — `pkill -f` olsaydı
# bu betiği koşturan kabuğu da eşleyip zincirin kalanını hiç çalıştırmazdı.
pkill -RTMIN+"$SIGNAL" -x waybar 2>/dev/null

printf '\033[1m----------------------------------------\033[0m\n\n'

# Başarılı koşuda hata logu ÇÖPTÜR, silinir; düşen koşuda yukarıda yolu
# basıldı ve DURUR (temizle=0). /tmp'yi süresiz kirletmemek için tek kural bu.
((temizle)) && [[ -n $hatalog ]] && rm -f "$hatalog"

[ -t 0 ] && { printf '  Kapatmak için bir tuşa bas... '; read -rsn1 _; printf '\n'; }
exit "$rc"
