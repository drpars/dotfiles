{
  "custom/launch_rofi": {
    "format": "",
    "on-click": "rofi -show drun -disable-history -replace -theme ~/.config/rofi/menu.rasi",
    "tooltip": false,
    "margin-top": 10
  },

  "custom/weather": {
    "exec": "~/.config/scripts/weather Çankırı",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 3600,
    // Tıklama betiği doğrudan çağırırsa çıktı hiçbir yere gitmez (modül kendi
    // exec'ini okur) — yalnızca boşuna bir wttr.in isteği olurdu. Doğrusu
    // modüle sinyal göndermek.
    "signal": 10,
    "on-click": "pkill -SIGRTMIN+10 waybar"
  },

  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 5
    }
  },

  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": true
    },
    "modules": ["custom/hardware", "cpu", "memory", "disk"]
  },

  "custom/hardware": {
    "format": "󰭵",
    "on-click": "~/.config/scripts/tuipop btop btop"
  },

  "cpu": {
    "interval": 10,
    "format": "  {usage}%",
    "max-length": 10,
    "tooltip": true
  },

  "memory": {
    "interval": 30,
    "format": "  {}%",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": "RAM - {used:0.1f}GB kullanılıyor"
  },

  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/home",
    "tooltip": true,
    "tooltip-format": "HDD - {path} üzerinde {total} alandan {used} alan kullanılıyor ({percentage_used}%)"
  },

  "group/temp": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": true
    },
    "modules": ["custom/temp", "custom/cputemp", "custom/gputemp"]
  },

  "custom/temp": {
    "format": ""
  },

  "custom/cputemp": {
    "exec": "~/.config/scripts/cputemp",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "~/.config/scripts/tuipop btop btop"
  },

  "custom/gputemp": {
    "exec": "~/.config/scripts/gputemp",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "~/.config/scripts/tuipop nvtop nvtop"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 65
  },

  "custom/lock_screen": {
    "format": "",
    "return-type": "",
    "on-click": "pidof hyprlock || hyprlock",
    "tooltip": true,
    "tooltip-format": "<span size='10pt' font='Ubuntu Nerd Font'>Kilitle</span>"
  },

  "custom/pacman": {
    // Yalnız simge: sayı bilerek gösterilmiyor (kullanıcı kararı 2026-08-13).
    // Betik sayıyı yine de "text"e yazıyor — biçim "{icon}{}" yapılırsa
    // görünür, betiğe dokunmak gerekmez.
    "format": "{icon}",
    "return-type": "json",
    "format-icons": {
      "pending-updates": "",
      "updated": ""
    },
    // DAEMON YOK ve bu bir arıza sonrası seçim. Önceki AUR paketi 6 sn'lik
    // sonsuz döngüydü; 2026-08-13'te öldü, waybar onu YENİDEN BAŞLATMADI
    // ("restart-interval" bu dosyada hiç yazmıyor) ve gösterge 4 saat boyunca
    // sessizce karanlıkta kaldı — o sırada 109 güncelleme bekliyordu. Kanıt
    // süreç ağacından: waybar 10 sa 46 dk ayaktaydı ve HİÇ ÇOCUĞU YOKTU.
    // Tek atımlık betikte ölecek daemon yok: başarısız koşu bir tura mal olur.
    // Bedeli ölçüldü — tam koşu (çevrimiçi senkron dahil) 3,2 sn, saatte bir.
    "interval": 3600,
    // Anında tazeleme kanalı: pkill -RTMIN+12 waybar. 8/9/10/11 dolu.
    "signal": 12,
    // Guard artık ARACI ölçüyor, betiği değil: betik depoda hep var (symlink),
    // makineye bağlı olan şey checkupdates'in varlığı (pacman-contrib).
    "exec-if": "command -v checkupdates",
    "exec": "~/.config/scripts/waybar-updates",
    // ÜÇ TIK, İKİSİ AYNI KİLİDİ PAYLAŞIYOR. tuipop'un kilidi ADA bağlı
    // (tuipop-<ad>.lock), bu yüzden sol ve sağ tık ikisi de "Update" adını
    // kullanıyor: biri koşarken diğerine tıklamak var olan pencereyi öne
    // getirir. Ayrı adlar yazılsaydı iki ayrı kilit olurdu ve pacman ile
    // yay SESSİZCE aynı anda koşardı — yay AUR paketlerini derlediği için
    // yarım güncellenmiş kütüphaneye karşı derleme riski gerçek, ve pacman'in
    // kendi db kilidi derleme adımını KORUMAZ.
    // Sağ tık `yay -Syu` DEĞİL: o repo paketlerini de alır ve sol tıkı
    // kapsardı. AUR-only bayrağı -a/--aur (ölçüldü, yay --help).
    "on-click": "~/.config/scripts/tuipop Update ~/.config/scripts/sysupdate repo",
    "on-click-right": "~/.config/scripts/tuipop Update ~/.config/scripts/sysupdate aur",
    // Orta tık = yeniden denetle. Güncelleme betikleri bitişte sinyali kendi
    // atıyor, yani bu yol yalnız "başka terminalden güncelledim" ya da
    // "saatlik turu beklemeyeceğim" için. Desen: bluetooth on-click-middle.
    "on-click-middle": "pkill -RTMIN+12 -x waybar"
  },

  "clock": {
    "format": "{:%H:%M} ",
    "format-alt": "{:L%d %B %A %Y (%R)} ",
    "locale": "tr_TR.UTF-8",
    "timezone": "Europe/Istanbul",
    "tooltip-format": "<span size='10pt' font='JetBrainsMono Nerd Font Mono'>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#2ac3de'><b>{}</b></span>",
        "days": "<span color='#bb9af7'><b>{}</b></span>",
        "weeks": "<span color='#565f89'><b>W{}</b></span>",
        "weekdays": "<span color='#e0af68'><b>{}</b></span>",
        "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/wallpaper": {
    "format": "",
    "on-click": "~/.config/scripts/wallselect",
    "on-click-right": "~/.config/scripts/randomwallpaper",
    "tooltip": true,
    "tooltip-format": "<span size='10pt' font='Ubuntu Nerd Font'>Duvarkağıdını değiştir</span>"
  },

  "custom/power_btn": {
    "format": "",
    "return-type": "",
    // Super+X ile AYNI menü. Eskiden burası wlogout çağırıyordu; ikisi de altı
    // aynı eylemi aynı komutlarla çalıştırıyordu (lock/suspend/hibernate/
    // logout/reboot/poweroff, ölçüldü 2026-08-21), tek fark powermenu'nün
    // yıkıcı dördü için Evet/Hayır onayı istemesiydi. Yani düğme, tuşun daha
    // az korumalı ikizini açıyordu.
    "on-click": "~/.config/scripts/powermenu",
    "tooltip": true,
    "tooltip-format": "<span size='10pt' font='Ubuntu Nerd Font'>Kapat</span>"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true
  },

  "group/peripherals": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": ["custom/peripherals", "custom/keyboard-battery", "custom/mouse-battery"]
  },

  // Çevre birimi pili saatler mertebesinde değişiyor; 60 sn'lik yoklama bunun
  // için fazlaydı ve her tur bir `solaar show` alt süreci demek. 300 sn: en
  // kötü bayatlık 5 dk, ve üç modülün toplamı dakikada 2 solaar çağrısından
  // 0,6'ya iniyor (çocuklar artık kümeyi okuduğu için tur başına 3 çağrı var).
  // Daha yukarı çıkılmadı: "signal": 9'u HİÇBİR betik göndermiyor, yani
  // interval tek tazeleme kanalı — fişe takınca yeşile dönmesi buna bağlı.
  "custom/peripherals": {
    "exec": "~/.config/scripts/peripheral-battery.py summary",
    "return-type": "json",
    "interval": 300,
    "format": "{}",
    "tooltip": true,
    "signal": 9
  },

  "custom/keyboard-battery": {
    "exec": "~/.config/scripts/peripheral-battery.py kbd",
    "return-type": "json",
    "interval": 300,
    "format": "{}",
    "tooltip": true,
    "signal": 9
  },

  "custom/mouse-battery": {
    "exec": "~/.config/scripts/peripheral-battery.py mouse",
    "return-type": "json",
    "interval": 300,
    "format": "{}",
    "tooltip": true,
    "signal": 9
  },

  "custom/power_profile": {
    "exec": "~/.config/scripts/powerprofileasus",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "on-click": "~/.config/scripts/powerprofileasus next",
    "on-click-right": "rog-control-center",
    "signal": 8
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "custom/language": {
    "exec": "~/.config/scripts/get-layout.sh",
    "interval": 1,
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    // signal olmadan on-click'teki pkill hiçbir şeye yaramıyordu: waybar
    // SIGRTMIN+N'i yalnızca "signal": N yazan modüle iletiyor. interval yine
    // gerekli — Alt+Shift (kb_options grp:alt_shift_toggle) buradan geçmiyor.
    "signal": 8,
    "on-click": "hyprctl switchxkblayout $(hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .name' | head -1) next && pkill -SIGRTMIN+8 waybar"
  },

  "bluetooth": {
    "interval": 1,
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "tooltip-format-off": "Bluetooth kapalı",
    "tooltip-format-disabled": "Bluetooth devre dışı (rfkill)",
    "format": "",
    "format-connected": "",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/scripts/tuipop Bluetooth bluetui",
    "on-click-middle": "~/.config/scripts/bt-reconnect",
    "on-click-right": "~/.config/scripts/togglebluetooth"
  },

  "network": {
    "interval": 1,
    "format": "{ifname}",
    "format-disabled": "󰖪",
    "format-wifi": "",
    // Bar ethernet'te YALNIZ GLİF taşır; adres tooltip'e indi (2026-08-22).
    // Glif U+F0200 = nf-md-ethernet (RJ45 jakı). Buradaki eski değer U+F0297
    // bir OYUN KOLU glifiydi ve fontta VARDI — "fc-list ':charset=' bulur"
    // testi glifin fontta olduğunu söyler, DOĞRU glif olduğunu söylemez.
    // Ayırt eden ölçüm: pango-view ile render edip bakmak (waybar'la aynı
    // Pango/fontconfig yığını) → NOTLAR.md, Tuzaklar.
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    // Genel `tooltip-format` fiilen YALNIZ `linked` durumunu kapsıyor
    // (network.cpp:352-354 linked/ethernet/wifi verir, öbür üçünün kendi
    // tooltip'i yazılı). U+F0C1 = zincir; oradaki oyun kolu da temizlendi.
    "tooltip-format": "{ifname} via {gwaddr} ",
    // Down/Up AYRI SATIRDA, tek satırda değil (2026-08-22). Sebep ölçüldü:
    // tek satırda tooltip kutusu sayılar büyüyüp küçüldükçe 157-212 px arası
    // geziniyordu. Karakterle doldurmak (pow_format'ın `{:>}` / `{:=}` biçimi)
    // ÇÖZMÜYOR — iki bağımsız sebeple: (a) bu font orantılı, boşluk 3 px ama
    // rakam 8 px, yani sabit karakter sayısı sabit piksel demek değil;
    // (b) `>` genişliği zaten bir TAVAN değil TABAN: auto ölçekte alan 6-10
    // karakter arası değişiyor ve `1000.0kb/s` 10 karakterle 9'luk dolguyu
    // taşıyor. Ayrı satırda en geniş bant satırı 111 px'de kalıyor ve kutunun
    // genişliğini `Ağ Geçidi: <gw>` satırı (135 px) çapalıyor → ölçülen
    // değişim 0 px. Çapanın koşulu yazılı: ağ geçidi satırı bant satırından
    // geniş kaldığı sürece sabit. → NOTLAR.md
    // İki tooltip aynı iskelette: arayüz → adres → ağ geçidi → bant genişliği.
    // {ipaddr}/{cidr}/{gwaddr} bar metniyle AYNI fmt store'dan geliyor
    // (network.cpp:479 ↔ :492), yani duruma bakmadan ikisinde de dolu;
    // {cidr} netlink RTM_NEWADDR'in ifa_prefixlen'i (:743), arayüz türünden
    // bağımsız. Adres modemin DHCP'sinden gelendir — ayrı bir kaynak yok.
    "tooltip-format-wifi": "{ifname}\n\n{essid}\t{signalStrength}%\nIP: {ipaddr}/{cidr}\nAğ Geçidi: {gwaddr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n\nIP: {ipaddr}/{cidr}\nAğ Geçidi: {gwaddr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
    "tooltip-format-disconnected": "Bağlantı Yok",
    "tooltip-format-disabled": "Kablosuz kapalı (rfkill)",
    "max-length": 50,
    "on-click": "~/.config/scripts/tuipop Wifi impala",
    "on-click-right": "~/.config/scripts/togglewifi"
  },

  "battery": {
    // "interval" YAZILMIYOR: varsayılan 60 (battery.cpp:19). Devralınan
    // dosyada 1 vardı ve hiç seçilmemişti — modules.json'un ilk import'uyla
    // geldi. Modülün asıl güncelleme kanalı zamanlayıcı değil: BAT0/uevent
    // üstünde inotify + power_supply üstünde udev netlink. Zamanlayıcının işi
    // kaynağın kendi yorumuyla "kaçırılmış bir inotify olayına karşı emniyet
    // ağı" (battery.cpp:73). Bar metni {icon}, yani on bir kovadan biri —
    // 30 W'ta bir kova ~13 dk (66,2 Wh tam şarj), fişteyken zaten sabit glif.
    // Görünen hiçbir şey 60'tan hızlısını istemiyor.
    // KABUL EDİLEN BEDEL: tooltip'teki {power} ve {time} 60 sn'ye kadar eski
    // olabilir — waybar tooltip'i hover anında değil zamanlayıcıda hesaplıyor.
    // Yetmezse çare ÖLÇÜLMÜŞ bir sayı yazmaktır, 1'e dönmek değil.
    // 1 Hz masaüstünde tümüyle boştu: modül pil yokluğundan gizli
    // (update() → batteries_.empty() → hide) ama worker()'ın zamanlayıcısı
    // koşulsuz koşup her turda /sys/class/power_supply'ı tarıyor
    // (refreshBatteries). Burada da çoğu tur boş: fişte/sınırda 60 sn
    // dinlendi, sıfır çekirdek uevent'i geldi (ölçüldü 2026-08-12).
    // BOŞ BIRAKILDI, unutulmadı — "Plugged" yükseltmesi bilerek kapalı.
    // battery.cpp:580'deki yükseltme yalnız adapter_ doluyken çalışıyor ve
    // "Discharging"i de kapsıyor; ADP0'da "status" dosyası olmadığı için
    // online=1 iken durum KOŞULSUZ Plugged oluyordu. Sonuç: "fişte ve sınırda"
    // ile "fişte ama gerçekten boşalıyor" tek duruma çöküyor, bar ikisini
    // ayıramıyordu. Adaptör boşken ham BAT0 durumu geçiyor ve ikisi ayrışıyor:
    // not-charging (sınırda) ↔ discharging (gerçekten düşüyor).
    // Boş dize adı hiçbir dizine eşleşmediği için adapter_ boş kalıyor
    // (battery.cpp:158); anahtarı hiç yazmamak AYNI ŞEY DEĞİL — o zaman
    // readdir sırasındaki son girdi seçiliyor. adapter_'ın başka iki
    // kullanıcısı bizi etkilemiyor: "full-at-plugged" yazılmadı ve
    // getAdapterStatus yalnız durum "Unknown" iken çağrılıyor (BAT0 okunuyor).
    // Masaüstünde modül zaten pil yokluğundan gizli.
    "adapter": "",
    // Yalnız "critical" kaldı, çünkü CSS'te karşılığı olan tek durum o.
    // "good" hiçbir zaman stillenmiyordu; "warning" 2026-08-12'de kaldırıldı —
    // düşük pil uyarısı batwarn.py'nin işi (UPower WarningLevel → mako) ve
    // durumun bardaki karşılığı yanıp sönmekti, bedeli ölçüldü: 6,86 W, tam da
    // en kötü anda. Karşılığı olmayan durum ölü ayardır, okuyanı yanıltır.
    "states": {
      "critical": 20
    },
    "format": "{icon}",
    "format-alt": "{time} {icon}",
    "full-at": 100,
    "format-full": "{icon} Full",
    // Fişteki iki durum da AYNI glifi gösteriyor (şimşek değil, fiş): barın
    // söylediği tek şey "fişte". Şarj oluyor mu yoksa sınırda mı — bu ayrımı
    // artık yalnızca tooltip taşıyor (aşağıda -charging ↔ -not-charging).
    // Kasıtlı; glifle de ayrılsın istenirse -charging'e şimşek geri yazılır.
    // Seviye ikonunu bu iki satırdan düşürmek ancak Plugged yükseltmesi kapalı
    // olduğu için güvenli — fişteyken ağır yükte pil gerçekten boşalırsa durum
    // "discharging" olur ve seviye ikonu görünür. Yükseltme açıkken o düşüş bu
    // satırların altında gizlenirdi, o yüzden ikon zorunluydu. Üçü birlikte
    // değişir: adapter, bu iki format, ve seviye ikonunun anlamı.
    "format-charging": "",
    "format-not-charging": "",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-time": "{H} sa {M} dk",
    "tooltip": true,
    // Durum anahtarı /sys/class/power_supply/BAT0/status'un küçük harflisi,
    // boşluklar tire olur: "Not charging" → not-charging. Seçim sırası
    // tooltip-format-<durum>-<state> > -<durum> > -<state> > tooltip-format.
    // {time} güç okuması 0 iken boş döner (fişe yeni takılan an) — o yüzden
    // her satır kendi başına da anlamlı.
    "tooltip-format": "{capacity}%",
    "tooltip-format-charging": "Şarj oluyor — {capacity}%\n{power:.1f} W · dolmasına {time}",
    "tooltip-format-discharging": "Pil — {capacity}%\n{power:.1f} W · bitmesine {time}",
    // "plugged" satırı yok: yükseltme kapalı olduğu için o durum ulaşılamaz.
    // Ölü ayar bırakmak yanıltıyor — okuyan onu yürürlükte sanıyor.
    "tooltip-format-not-charging": "Prize takılı — {capacity}%\nŞarj etmiyor (şarj sınırı)",
    "tooltip-format-full": "Pil dolu — {capacity}%"
  },

  "backlight": {
    // "device" bilerek yazılmıyor: aygıt adı MAKİNEDEN DE ÖNCE BOOT'A GÖRE
    // değişiyor — bu dizüstünde bir açılışta amdgpu_bl2, sonrakinde amdgpu_bl1
    // (ölçüldü 2026-08-13). waybar ad tutmazsa zaten "backlight" alt sistemi
    // aygıtını kendisi seçiyor. Yanlış ad sessizce otomatik seçime düşer, yani
    // yazmak yalnızca yanıltır.
    //
    // on-scroll-*/on-click-* betiğe gidiyor ve bu ZORUNLU: waybar-backlight(5),
    // bu girdilerin "parlaklık denetiminin varsayılan davranışını DEĞİŞTİRDİĞİNİ"
    // söylüyor. Modülün kendi yazma yolunda tavan diye bir seçenek yok
    // (min-brightness var, karşılığı yok), yani girdiler kaldırılırsa panelin
    // söndüğü ham değer buradan yazılabilir hâle gelir → scripts/brightness.
    //
    // {percent} max_brightness'a bölünüyor, betiğin kullandığı tavana değil:
    // tepede ~%97 okur. Yanlış değil — betik erişilemez bir aralığı dışarıda
    // bırakıyor (amdgpu'nun PWM eşlemesi tepede sarıyor, gerekçe betikte).
    // waybar'da bunu düzeltecek bir anahtar yok; format {icon} olduğu için
    // fark yalnız tooltip'te görünür ve üç ikonun seçimi etkilenmiyor.
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "$HOME/.config/scripts/brightness up",
    "on-click-right": "$HOME/.config/scripts/brightness down",
    "on-scroll-up": "$HOME/.config/scripts/brightness up",
    "on-scroll-down": "$HOME/.config/scripts/brightness down",
    "tooltip-format": "{percent}%"
  },

  "custom/refreshrate": {
    "exec": "~/.config/scripts/refreshrate status",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    // YOKLAMA YOK ve bu ölçülmüş bir seçim: "once" modülü açılışta bir kez
    // koşturuyor, SIGRTMIN+11 her geldiğinde bir kez daha, kendiliğinden hiç
    // (ölçüldü 2026-08-12: 1 → 2 → 3 koşum, aradaki 4 sn'de artış yok).
    // Sinyali betiğin kendisi atıyor; hız yalnızca o betikle değişiyor.
    // KABUL EDİLEN BEDEL: mod dışarıdan değiştirilirse (doğrudan hyprctl)
    // gösterge bayatlar. Hyprland mod değişiminde OLAY YAYINLAMIYOR — 2026-08-12'de
    // .socket2.sock dinlenerek ölçüldü, iki mod değişiminde sıfır monitör olayı —
    // yani olay güdümlü tazeleme diye bir seçenek yok, yoklamaya dönmek gerekirdi.
    "interval": "once",
    "signal": 11,
    "on-click": "~/.config/scripts/refreshrate toggle"
  },

  "wireplumber": {
    "format": "{icon}",
    "format-muted": "",
    "on-click": "$HOME/.config/scripts/volume togglevol",
    "on-click-right": "pavucontrol",
    "max-volume": 100,
    "on-scroll-up": "$HOME/.config/scripts/volume upvol",
    "on-scroll-down": "$HOME/.config/scripts/volume downvol",
    "format-icons": ["", "", ""],
    "tooltip-format": "{volume}%"
  },

  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "scroll-step": 5
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "$HOME/.config/scripts/volume togglemic",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "$HOME/.config/scripts/volume upmic",
    "on-scroll-down": "$HOME/.config/scripts/volume downmic",
    "tooltip-format": "{source_volume}%"
  },

  "custom/hypridle": {
    "interval": 1,
    "format": "",
    "format-alt": "",
    "return-type": "json",
    "escape": true,
    "exec-on-event": true,
    "exec": "$HOME/.config/scripts/hypridle status",
    "on-click": "$HOME/.config/scripts/hypridle toggle"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Otomatik uyku/kilit devre dışı",
    "tooltip-format-deactivated": "Otomatik uyku/kilit devrede"
  }
}
