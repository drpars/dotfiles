{
  "layer": "top",
  "position": "top",
  // "mode" YAZILMIYOR: hazır "dock" kipi layer'ı bottom'a çekiyor ve
  // yukarıdaki "layer": "top" satırını ezerdi. Kip verilmediğinde waybar
  // "default" kipini kullanır, o kip de zaten buradaki genel ayarlardan
  // doldurulur — istenen davranış bu.
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  "include": "~/.config/waybar/modules.json",

  "modules-left": [
    "custom/launch_rofi",
    "hyprland/workspaces",
    "group/hardware",
    "group/temp",
    // "cpu",
    // "memory",
    // "disk",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/lock_screen",
    "custom/pacman",
    "clock",
    "custom/wallpaper",
    "custom/power_btn"
  ],
  "modules-right": [
    "tray",
    // "custom/power_profile",
    // "power-profiles-daemon",
    "bluetooth",
    "network",
    "wireplumber",
    // "wireplumber#source",
    // "pulseaudio#microphone",
    "backlight",
    "custom/refreshrate",
    "group/peripherals",
    "battery",
    "custom/weather",
    "custom/language",
    "idle_inhibitor"
    // "custom/hypridle"
  ]
}
