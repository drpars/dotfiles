config/zsh/.zsh_history
config/btop/btop.log
config/OpenRGB/logs/
config/OpenRGB/sizes.ors
config/mc/ini
home/.fonts/.uuid

# ~/.config/systemd bu depoya symlink oldugu icin `systemctl --user enable`
# etkinlestirme symlink'lerini buraya yaziyor. Makine durumu, depoya girmez.
config/systemd/user/*.wants/


# ~/.local/share/applications bu depoya symlink oldugu icin
# update-desktop-database ciktisini buraya yaziyor. Uretilen onbellek,
# depoya girmez.
local/share/applications/mimeinfo.cache

# Ayni dizine dusen ikinci uretilmis dosya. XDG'nin ARTIK KULLANILMAYAN
# mimeapps konumu; GUI "birlikte ac" diyaloglari bos bir dosya olarak
# birakiyor. Gecerli olan config/mimeapps.list ve o versiyonlaniyor -- desen
# bu yuzden dizin yoluyla yazildi, ciplak "mimeapps.list" ile degil: oyle
# yazilsaydi gercek dosyayi da yok sayardi.
local/share/applications/mimeapps.list


# GTK dosya yoneticisi yer imleri: kullanici durumu ve yerele bagli
# (masaustunde ~/Projects, dizustunde ~/Projeler). GTK bu dosyada degisken
# genisletmiyor, o yuzden versiyonlanmiyor.
config/gtk-3.0/bookmarks


# ~/.config/looking-glass bu depoya symlink oldugu icin istemci kendi durum
# dosyalarini buraya yaziyor. Dizini istemcinin KENDISI olusturuyor
# (main.c:1865 lgPathsInit, her calistirmada) -- yani symlink dizin
# duzeyindedir ve uretilen dosyalar kacinilmaz. Versiyonlanan tek sey
# config/looking-glass/client.ini.
config/looking-glass/imgui.ini
config/looking-glass/presets/

# Betikler yerinde derlenince (py_compile, import) olusuyor. Uretilen
# bytecode, depoya girmez -- bir kez calisma agacina dustu.
config/scripts/__pycache__/
