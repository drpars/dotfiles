config/zsh/.zsh_history
config/btop/btop.log
config/OpenRGB/logs/
config/OpenRGB/sizes.ors
config/mc/ini
home/.fonts/.uuid

# ~/.config/systemd bu depoya symlink oldugu icin `systemctl --user enable`
# etkinlestirme symlink'lerini buraya yaziyor. Makine durumu, depoya girmez.
config/systemd/user/*.wants/

# Hangi duvar kagidinin secili oldugu makine durumudur, yapilandirma degil.
# wallselect bu symlink i her secimde yeniden yazar.
config/hypr/images/wallpaper_symlink

# GTK dosya yoneticisi yer imleri: kullanici durumu ve yerele bagli
# (masaustunde ~/Projects, dizustunde ~/Projeler). GTK bu dosyada degisken
# genisletmiyor, o yuzden versiyonlanmiyor.
config/gtk-3.0/bookmarks
