#!/usr/bin/env bash
# gitleaks pre-commit -- staged icerikte sir ararsa commit'i durdurur.
#
# Bu depo PUBLIC ve icerigi bastan sona yapilandirma dosyasi. Kancayi hak
# eden hata bugun duran bir sey degil -- gecmis 2026-08-06'da tarandi, 54
# commit, sizinti yok -- ileride EKLENECEK bir dosya: ssh/sshfs konak
# tanimi, bir servis anahtari, ya da bir betige gomulen token. Sir barindiran
# seyler depoya hic girmiyor (ornek: ~/.gitconfig.local'i archsetup uretir),
# ve kancanin isi o kurali kaza eseri bozmayi engellemek.
#
# Kanca surumlenir ve klonlanir; onu etkinlestiren ayar klonlanmaz.
# Klon basina bir kez:
#     git config core.hooksPath .githooks
#
# gitleaks 8.19'da `protect` yerine `git --staged` geldi ama `protect` hala
# duruyor. Hangi surumun kurulu oldugu betik yazilirken bilinmiyor, o yuzden
# alt komut calisma aninda seciliyor.

set -uo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '\033[1;31mpre-commit: gitleaks kurulu degil, commit durduruldu.\033[0m\n'
    printf 'Kur:  sudo pacman -S gitleaks\n'
    printf 'Atla: git commit --no-verify   (yalnizca ne yaptigini biliyorsan)\n'
    exit 1
fi

if gitleaks protect --help >/dev/null 2>&1; then
    gitleaks protect --staged --redact --verbose
else
    gitleaks git --staged --redact --verbose .
fi
DURUM=$?

if [[ $DURUM -ne 0 ]]; then
    printf '\n\033[1;31mpre-commit: gitleaks bulgu verdi, commit durduruldu.\033[0m\n'
    printf 'Yanlis alarmsa .gitleaksignore dosyasina parmak izini ekle.\n'
    exit 1
fi

exit 0
