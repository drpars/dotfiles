[Desktop Entry]
Type=Application
Version=1.0
Name=Windows 11
Comment=Misafiri baslat ve masaustunu ac (Looking Glass)
Comment[tr]=Misafiri baslat ve masaustunu ac (Looking Glass)
# Sabit ev dizini yolu gomulmedi: Exec'i isleyen taraf ~ genisletmiyor, o yuzden
# kabuk uzerinden cagriliyor. Tirnak bicimi spec'in kendi kurali -- tilde
# ayrilmis karakter, cift tirnak icinde durmali (desktop-file-validate ile
# dogrulandi). Ayni betigi `win` alias'i da calistirir.
Exec=sh -c "exec ~/.config/scripts/win"
# LG kurulu olmayan makinede girdi kendiliginden gizlenir.
TryExec=looking-glass-client
# Ikon depoya konmadi: ad tema icinde cozunuyor. Dogrulama Gtk.IconTheme ile
# yapildi, dosya varligiyla DEGIL -- devralma zinciri her ada bir sonuc
# dondurur, bkz. NOTLAR.md tuzagi. rofi'nin kendi icon-theme'i de ayni temaya
# ayarli, yani menude de ayni dosya cizilir.
# AD TEMAYA BAGLI ve ortak bir ad YOK (olculdu 2026-08-28, Gtk.IconTheme):
#   Qogir-Dark    -> `windows` VAR, `distributor-logo-windows` yok
#   Papirus-Dark  -> `windows` yok, `distributor-logo-windows` VAR
# Bugun tema Papirus-Dark oldugu icin ad `distributor-logo-windows`. Tema
# Qogir'e geri alinirsa BU SATIR DA geri alinmali; ikisini birden kurtaran tek
# yol ikonu depoya hicolor altina koymak olurdu (webapp-* girdilerinin yaptigi
# gibi) -- yapilmadi.
# Onceki deger looking-glass idi: goruntuleyiciyi adlandiriyordu, oysa girdinin
# isi misafiri baslatmak -- Name= da "Windows 11" diyor.
Icon=distributor-logo-windows
Terminal=false
StartupNotify=false
StartupWMClass=looking-glass-client
Categories=System;Emulator;
Keywords=windows;vm;kvm;looking glass;
