[Desktop Entry]
Name=Claude Code URL Handler
Comment=Handle claude-cli:// deep links for Claude Code
# Bu girdiyi Claude Code'un kendisi uretti (claude-cli:// derin baglantilarini
# yerel CLI'a acar). ~/.local/share/applications depoya symlink oldugu icin
# dogrudan buraya dustu ve izlenmeye alindi. CLI guncellemesi dosyayi yeniden
# yazarsa asagidaki Exec mutlak yola geri donebilir -- kontrol noktasi burasi.
#
# Sabit ev dizini yolu yerine kabuk uzerinden cagriliyor: Exec'i isleyen taraf
# ~ genisletmez ve Hyprland oturumunun PATH'inde ~/.local/bin YOKTUR (olculdu),
# yani ciplak `claude` de bulunmaz. $ isareti CIFT ters bolu ile kacilir: tek
# ters bolu (\$1) desktop-file-validate'ten gecer ama GLib anahtar dosyasini
# gecersiz kacis sayip girdiyi HIC yuklemez (olculdu).
Exec=sh -c "exec ~/.local/bin/claude --handle-uri \\$1" sh %u
# TryExec bilerek yok: ~ genisletmedigi icin yalnizca mutlak yol yazilabilirdi,
# ciplak ad ise PATH'te claude olmadigindan girdiyi her makinede gizlerdi.
Type=Application
NoDisplay=true
MimeType=x-scheme-handler/claude-cli;
