[Desktop Entry]
Type=Application
Name=WhatsApp
Comment=WhatsApp Web (Chrome uygulama kipi)
# Elle yazildi -- webapp-manager uretmedi. Aracin urettigi girdi
# --user-data-dir'e SABIT /home/drpars yolu yaziyor (depoya girmemesi gereken
# bicim) ve Exec'i kurulu olmayan chromium'a bagliyordu; bu makinede kurulu
# Chromium ailesi tarayici google-chrome-stable.
#
# ~ genisletilmez (olculdu, README'deki tabloya bak), o yuzden sh uzerinden
# $HOME. $ isareti CIFT ters bolu ile kacilir: tek ters bolu (\$HOME)
# desktop-file-validate'ten gecer ama GLib gecersiz kacis sayip girdiyi HIC
# yuklemez.
Exec=sh -c "exec google-chrome-stable --app=https://web.whatsapp.com/ --user-data-dir=\\$HOME/.local/share/webapps/whatsapp"
# --class BILEREK YOK: Chrome Wayland'de bu bayragi yok sayiyor (olculdu
# 2026-08-06). Verilen ada ragmen app_id'yi --app URL'i + profil adindan
# turetiyor -> chrome-web.whatsapp.com__-Default. Pencere kurali ve asagidaki
# StartupWMClass o turetilmis ada bakar; --class yazmak calisiyormus izlenimi
# verirdi.
StartupWMClass=chrome-web.whatsapp.com__-Default
# Tema ikonu, depoda dosya yok. Onceki ad `web-whatsapp` idi ve yanindaki not
# "tema degisince ikon da degisir, kirilmaz" diyordu -- OLCULEREK YANLIS cikti
# (2026-08-28): o adi yalnizca Qogir cozuyor, Papirus-Dark'ta Gtk.IconTheme
# has_icon=hayir donduruyor, yani tema degisince ikon KIRILIYORDU.
# `whatsapp` ise HER IKI temada da cozunuyor (Qogir-Dark/scalable/apps/
# whatsapp.svg ve Papirus-Dark/48x48/categories/whatsapp.svg), o yuzden ad
# bununla degistirildi -- ve tema Qogir'e geri alinirken de BOYLE BIRAKILDI,
# cunku `web-whatsapp`e donmek yalnizca kirilgan adi geri getirirdi.
# Dogrulama Gtk.IconTheme.has_icon ile yapildi, dosya varligiyla DEGIL -- ve
# `find` ile yapilan ilk sonda da yaniltmisti, cunku ~/.local/share/icons bir
# symlink ve find onu -L olmadan izlemiyor.
Icon=whatsapp
Terminal=false
Categories=Network;InstantMessaging;
