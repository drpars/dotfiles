[Desktop Entry]
Type=Application
Name=Prime Video
Comment=Prime Video (Chrome uygulama kipi)
# Elle yazildi. Gerekce ve ~ / \\$ kacis tuzagi icin bkz.
# webapp-whatsapp.desktop -- ayni bicim, ayni olcumler.
#
# Bu girdi special workspace'e BAGLANMAZ: izleme yuzeyi, toggle yuzeyi degil.
# Scratchpad acip kapamanin kazanci yok, tam ekranla da cakisirdi.
Exec=sh -c "exec google-chrome-stable --app=https://www.primevideo.com/region/eu/storefront --user-data-dir=\\$HOME/.local/share/webapps/primevideo"
StartupWMClass=chrome-www.primevideo.com__region_eu_storefront-Default
Icon=google-chrome
Terminal=false
Categories=AudioVideo;Video;
