[Desktop Entry]
Type=Application
Name=Prime Video
Comment=Prime Video (Chrome uygulama kipi)
# Elle yazildi. Gerekce ve ~ / \\$ kacis tuzagi icin bkz.
# webapp-whatsapp.desktop -- ayni bicim, ayni olcumler.
#
# Bu girdi special workspace'e BAGLANMAZ: izleme yuzeyi, toggle yuzeyi degil.
# Scratchpad acip kapamanin kazanci yok, tam ekranla da cakisirdi.
Exec=sh -c "exec google-chrome-stable --app=https://www.primevideo.com/region/eu/storefront --user-data-dir=\\$HOME/.local/share/webapps/primevideo"
StartupWMClass=chrome-www.primevideo.com__region_eu_storefront-Default
# Prime Video'nun kendi ikonu KURULU HICBIR TEMADA YOK (arandi: Qogir ailesi,
# Adwaita, breeze, hicolor). Genel ama dogru ikon: video-player.
#
# Gercek logo istenirse tesisat ZATEN KURULU: ~/.local/share/icons depoya
# symlink (local/share/icons/, archsetup'in "local" bolumu). Dosya
# local/share/icons/hicolor/<boyut>/apps/ altina konur ve Icon= ADI yazar --
# mutlak yol yazilmaz. Boyut hicolor'in ilan ettiklerinden biri olmali
# (16..128, 192, 256, 512); ornegin 152x152 ILAN EDILMEMIS, once olceklenir.
Icon=video-player
Terminal=false
Categories=AudioVideo;Video;
