[Desktop Entry]
Type=Application
Name=YouTube
Comment=YouTube (Chrome uygulama kipi)
# Elle yazildi. Bicim ve ~ / \\$ kacis tuzagi icin bkz.
# webapp-whatsapp.desktop.
#
# Bu girdi de special workspace'e BAGLANMAZ (bkz. webapp-primevideo.desktop):
# izleme yuzeyi, toggle yuzeyi degil.
#
# Turkiye'den gercekten aciliyor (olculdu 2026-08-07): www.youtube.com/ 200
# donuyor ve sayfa "GL":"TR" + "hl":"tr" ile geliyor -- konum Turkiye olarak
# taniniyor.
#
# URL'deki SON EGIK CIZGI onemli (bkz. webapp-netflix.desktop): Chrome app_id'yi
# URL'den turettigi icin .../ ile ... farkli sinif uretir.
Exec=sh -c "exec google-chrome-stable --app=https://www.youtube.com/ --user-data-dir=\\$HOME/.local/share/webapps/youtube"
StartupWMClass=chrome-www.youtube.com__-Default
# Tema ikonu, depoda dosya YOK -- webapp-whatsapp.desktop ile ayni yol.
# Aktif tema adi kendi cozuyor (olculdu, Gtk.IconTheme.lookup_icon):
# /usr/share/icons/Qogir-Dark/scalable/apps/youtube.svg (Qogir'e symlink).
# Diger dort web app depoya ikon koydu cunku onlarin ikonu KURULU HICBIR
# TEMADA yoktu; bu adin oyle bir sorunu yok: 24 tema dizininden 13'u cozuyor
# (Qogir ailesi + Tokyonight ailesi), yani `web-whatsapp`ten (9) daha genis.
# Mutlak yol yazilmadigi icin tema degisince ikon da degisir, kirilmaz.
#
# `im-youtube` DEGIL: o Qogir'de Actions baglaminda, 24 px Type=Fixed ve logo
# degil genel bir oynatici glifi. Ad secilirken baglam da bakilir.
Icon=youtube
Terminal=false
Categories=AudioVideo;Video;
